<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - front_gym</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/front_gym.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">front_gym</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @if (!string.IsNullOrEmpty(Context.Session.GetString("UsuarioNombre")))
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                            </li>

                       
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Clientes</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Clientes">Clientes</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Membresias">Membresías</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Pagos">Pagos</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Valoraciones_Medicas">Valoraciones médicas</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Rutinas_Personalizadas">Rutinas personalizadas</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Ejercicios">Ejercicios</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Dias_Ingreso">Días de ingreso</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Personal</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Trabajadores">Trabajadores</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Cargos">Cargos</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/AsistenciaTrabajadores">Asistencia trabajadores</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Clases</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Clases">Clases</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Tipo_Clases">Tipo de clases</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Reservas_Clases">Reservas de clases</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Tienda</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Tienda">Tienda</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Productos">Productos</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Detalle_Producto">Detalle de producto</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Proveedores">Proveedores</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Gimnasio</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Gym">Gym</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Casilleros">Casilleros</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Mantenimiento_Equipos">Mantenimiento de equipos</a></li>
                                </ul>
                            </li>
                            @if (Context.Session.GetString("Rol") == "Administrador")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">Seguridad</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Roles">Roles</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Usuarios">Usuarios</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Logins">Logins</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Ventanas/Auditorias">Auditorías</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <span class="navbar-text me-3">
                            👤 @Context.Session.GetString("UsuarioNombre") (@Context.Session.GetString("Rol"))
                        </span>
                        <a class="btn btn-outline-secondary btn-sm" href="/CerrarSesion">Cerrar sesión</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - front_gym - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>