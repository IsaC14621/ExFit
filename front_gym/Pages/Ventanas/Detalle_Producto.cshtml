@page
@model Detalle_ProductoModel
@{
    ViewData["Title"] = "Detalle_Producto";
}

<form method="post">

    <div class="text-center">
        <h1 class="display-4">Detalle de producto</h1>

        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />

            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />

            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />

            <input id="flid_Venta"
                   placeholder="Id venta"
                   type="number"
                   asp-for="Filtro!.id_Venta" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Detalle de producto</h3>

                <label>Id venta</label>
                <input id="nmid_Venta"
                       type="number"
                       asp-for="Actual!.id_Venta" />
                <br />

                <label>Id producto</label>
                <input id="nmId_Producto"
                       type="number"
                       asp-for="Actual!.Id_Producto" />
                <br />

                <label>Cantidad</label>
                <input id="nmCantidad"
                       type="number"
                       asp-for="Actual!.Cantidad" />
                <br />

                <label>Subtotal</label>
                <input id="nmSubtotal"
                       type="number"
                       step="0.01"
                       asp-for="Actual!.Subtotal" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Quiere borrar el detalle del producto
                        @Model.Actual!.Id_Producto
                        de la venta @Model.Actual!.id_Venta?
                    </h4>

                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />

            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">

                    <tr>
                        <th>Id venta</th>
                        <th>Id producto</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                        <th>Acción</th>
                    </tr>

                    @if (Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.id_Venta</td>
                                <td>@elemento.Id_Producto</td>
                                <td>@elemento.Cantidad</td>
                                <td>@elemento.Subtotal.ToString("N2")</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />

                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>