@page
@model Rutinas_PersonalizadasModel
@{
    ViewData["Title"] = "Rutinas Personalizadas";
}

<form method="post">

    <div class="text-center">
        <h1 class="display-4">Rutinas Personalizadas</h1>

        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />

            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />

            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />

            <input id="flIdCliente"
                   type="number"
                   placeholder="Id Cliente"
                   asp-for="Filtro!.id_Cliente" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Rutinas Personalizadas</h3>

                <label>Id Cliente</label>
                <input id="nmIdCliente"
                       type="number"
                       asp-for="Actual!.id_Cliente" />
                <br />

                <label>Nombre de la rutina</label>
                <input id="nmNombreRutina"
                       maxlength="150"
                       asp-for="Actual!.Nombre_Rutina" />
                <br />

                <label>Fecha de inicio</label>
                <input id="nmFechaInicio"
                       type="date"
                       asp-for="Actual!.Fecha_Inicio" />
                <br />

                <label>Objetivo</label>
                <input id="nmObjetivo"
                       maxlength="150"
                       asp-for="Actual!.Objetivo" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Quiere borrar la rutina con la información
                        @Model.Actual!.Nombre_Rutina,
                        Cliente @Model.Actual!.id_Cliente?
                    </h4>

                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />

            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">

                    <tr>
                        <th>Id</th>
                        <th>Id Cliente</th>
                        <th>Nombre de la rutina</th>
                        <th>Fecha de inicio</th>
                        <th>Objetivo</th>
                        <th>Acción</th>
                    </tr>

                    @if (Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.id_Cliente</td>
                                <td>@elemento.Nombre_Rutina</td>
                                <td>@elemento.Fecha_Inicio.ToString("dd/MM/yyyy")</td>
                                <td>@elemento.Objetivo</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />

                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>
