@page
@model TiendaModel
@{
    ViewData["Title"] = "Tienda";
}

<form method="post">

    <div class="text-center">
        <h1 class="display-4">Tienda</h1>

        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />

            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />

            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />

            <input id="flid_Producto"
                   placeholder="Id producto"
                   type="number"
                   asp-for="Filtro!.id_Producto" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Tienda</h3>

                <label>Id producto</label>
                <input id="nmid_Producto"
                       type="number"
                       asp-for="Actual!.id_Producto" />
                <br />

                <label>Precio</label>
                <input id="nmPrecio"
                       type="number"
                       step="0.01"
                       asp-for="Actual!.Precio" />
                <br />

                <label>Cantidad disponible</label>
                <input id="nmCantidad_Disponible"
                       type="number"
                       asp-for="Actual!.Cantidad_Disponible" />
                <br />

                <label>Cantidad de productos</label>
                <input id="nmCantidad_Productos"
                       type="number"
                       asp-for="Actual!.Cantidad_Productos" />
                <br />

                <label>Id proveedor</label>
                <input id="nmId_Provedor"
                       type="number"
                       asp-for="Actual!.Id_Provedor" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Quiere borrar el registro de tienda del producto
                        @Model.Actual!.id_Producto?
                    </h4>

                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />

            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">

                    <tr>
                        <th>Id producto</th>
                        <th>Precio</th>
                        <th>Cantidad disponible</th>
                        <th>Cantidad de productos</th>
                        <th>Id proveedor</th>
                        <th>Acción</th>
                    </tr>

                    @if (Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.id_Producto</td>
                                <td>@elemento.Precio.ToString("N2")</td>
                                <td>@elemento.Cantidad_Disponible</td>
                                <td>@elemento.Cantidad_Productos</td>
                                <td>@elemento.Id_Provedor</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />

                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>
