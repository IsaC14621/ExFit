@page
@model Valoraciones_MedicasModel
@{
    ViewData["Title"] = "Valoraciones Medicas";
}

<form method="post">

    <div class="text-center">
        <h1 class="display-4">Valoraciones Medicas</h1>

        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />

            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />

            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />

            <input id="flIdCliente"
                   type="number"
                   placeholder="Id Cliente"
                   asp-for="Filtro!.Id_Cliente" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Valoraciones Medicas</h3>

                <label>Id Cliente</label>
                <input id="nmIdCliente"
                       type="number"
                       asp-for="Actual!.Id_Cliente" />
                <br />

                <label>Peso (kg)</label>
                <input id="nmPeso"
                       type="number"
                       step="0.01"
                       asp-for="Actual!.Peso" />
                <br />

                <label>Estatura (m)</label>
                <input id="nmEstatura"
                       type="number"
                       step="0.01"
                       asp-for="Actual!.Estatura" />
                <br />

                <label>IMC</label>
                <input id="nmIMC"
                       type="number"
                       step="0.01"
                       asp-for="Actual!.IMC" />
                <br />

                <label>Fecha de evaluación</label>
                <input id="nmFecha"
                       type="date"
                       asp-for="Actual!.Fecha_Evaluacion" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Quiere borrar la valoración con la información
                        Cliente @Model.Actual!.Id_Cliente,
                        @Model.Actual!.Fecha_Evaluacion.ToString("dd/MM/yyyy")?
                    </h4>

                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />

            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">

                    <tr>
                        <th>Id</th>
                        <th>Id Cliente</th>
                        <th>Peso</th>
                        <th>Estatura</th>
                        <th>IMC</th>
                        <th>Fecha de evaluación</th>
                        <th>Acción</th>
                    </tr>

                    @if (Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.Id_Cliente</td>
                                <td>@elemento.Peso.ToString("N2")</td>
                                <td>@elemento.Estatura.ToString("N2")</td>
                                <td>@elemento.IMC.ToString("N2")</td>
                                <td>@elemento.Fecha_Evaluacion.ToString("dd/MM/yyyy")</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />

                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>
