@page
@model PagosModel
@{
    ViewData["Title"] = "Pagos";
}

<form method="post">

    <div class="text-center">
        <h1 class="display-4">Pagos</h1>

        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />

            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />

            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />

            <input id="flIdMembresia"
                   type="number"
                   placeholder="Id Membresía"
                   asp-for="Filtro!.Id_Membresia" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Pagos</h3>

                <label>Id Membresía</label>
                <input id="nmIdMembresia"
                       type="number"
                       asp-for="Actual!.Id_Membresia" />
                <br />

                <label>Valor a pagar</label>
                <input id="nmValor"
                       type="number"
                       step="0.01"
                       asp-for="Actual!.Valor_a_pagar" />
                <br />

                <label>Fecha de pago</label>
                <input id="nmFecha"
                       type="date"
                       asp-for="Actual!.Fecha_Pago" />
                <br />

                <label>Método de pago</label>
                <input id="nmMetodo"
                       maxlength="100"
                       asp-for="Actual!.Metodo_Pago" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Quiere borrar el pago con la información
                        Membresía @Model.Actual!.Id_Membresia,
                        @Model.Actual!.Fecha_Pago.ToString("dd/MM/yyyy")?
                    </h4>

                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />

            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">

                    <tr>
                        <th>Id Membresía</th>
                        <th>Valor a pagar</th>
                        <th>Fecha de pago</th>
                        <th>Método de pago</th>
                        <th>Acción</th>
                    </tr>

                    @if (Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id_Membresia</td>
                                <td>@elemento.Valor_a_pagar.ToString("N2")</td>
                                <td>@elemento.Fecha_Pago.ToString("dd/MM/yyyy")</td>
                                <td>@elemento.Metodo_Pago</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />

                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>