@page
@model CasillerosModel
@{
    ViewData["Title"] = "Casilleros";
}

<form method="post">

    <div class="text-center">
        <h1 class="display-4">Casilleros</h1>

        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />

            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />

            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />

            <input id="flEstado"
                   placeholder="Estado"
                   asp-for="Filtro!.Estado" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Casilleros</h3>

                <label>Id casillero</label>
                <input id="nmid_Casillero"
                       type="number"
                       asp-for="Actual!.id_Casillero" />
                <br />

                <label>Número de casillero</label>
                <input id="nmNumero_Casillero"
                       type="number"
                       asp-for="Actual!.Numero_Casillero" />
                <br />

                <label>Cliente</label>
                <input id="nmid_Cliente"
                       type="number"
                       asp-for="Actual!.id_Cliente" />
                <br />

                <label>Estado</label>
                <input id="nmEstado"
                       asp-for="Actual!.Estado" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Quiere borrar el casillero número
                        @Model.Actual!.Numero_Casillero
                        (@Model.Actual!.Estado)?
                    </h4>

                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />

            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">

                    <tr>
                        <th>Id casillero</th>
                        <th>Número de casillero</th>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>

                    @if (Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.id_Casillero</td>
                                <td>@elemento.Numero_Casillero</td>
                                <td>@elemento.id_Cliente</td>
                                <td>@elemento.Estado</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />

                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>