@page
@model Dias_IngresoModel
@{
    ViewData["Title"] = "Dias_Ingreso";
}

<form method="post">

    <div class="text-center">
        <h1 class="display-4">Días de ingreso</h1>

        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />

            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />

            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />

            <input id="flTipo_Membresia"
                   placeholder="Tipo de membresía"
                   asp-for="Filtro!.Tipo_Membresia" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                   asp-for="Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Días de ingreso</h3>

                <label>Huella</label>
                <input id="nmHuella"
                       asp-for="Actual!.Huella" />
                <br />

                <label>Tipo de membresía</label>
                <input id="nmTipo_Membresia"
                       asp-for="Actual!.Tipo_Membresia" />
                <br />

                <label>Id cliente</label>
                <input id="nmId_Cliente"
                       type="number"
                       asp-for="Actual!.Id_Cliente" />
                <br />

                <label>Hora de ingreso</label>
                <input id="nmHora_ingreso"
                       type="datetime-local"
                       asp-for="Actual!.Hora_ingreso"
                       asp-format="{0:yyyy-MM-ddTHH:mm}" />
                <br />

                <label>Hora de salida</label>
                <input id="nmHora_salida"
                       type="datetime-local"
                       asp-for="Actual!.Hora_salida"
                       asp-format="{0:yyyy-MM-ddTHH:mm}" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Quiere borrar el ingreso del cliente
                        @Model.Actual!.Id_Cliente
                        del @Model.Actual!.Hora_ingreso.ToString("dd/MM/yyyy HH:mm")?
                    </h4>

                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />

                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />

            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">

                    <tr>
                        <th>Huella</th>
                        <th>Tipo de membresía</th>
                        <th>Id cliente</th>
                        <th>Hora de ingreso</th>
                        <th>Hora de salida</th>
                        <th>Acción</th>
                    </tr>

                    @if (Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Huella</td>
                                <td>@elemento.Tipo_Membresia</td>
                                <td>@elemento.Id_Cliente</td>
                               <td>@(elemento.Hora_ingreso == null ? "-" : $"{elemento.Hora_ingreso:dd/MM/yyyy HH:mm}")</td>
                               <td>@(elemento.Hora_salida == null ? "-" : $"{elemento.Hora_salida:dd/MM/yyyy HH:mm}")</td>

                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />

                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>